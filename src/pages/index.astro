---
const year = new Date().getFullYear();

const projects = [
  {
    title: "Fedora Hyprland Desktop",
    description:
      "A reproducible Fedora desktop environment built around Hyprland, with an emphasis on automation, performance and maintainability.",
    technologies: ["Linux", "Hyprland", "Shell"],
  },
  {
    title: "Homelab Dashboard",
    description:
      "A dashboard for operating and observing self-hosted infrastructure and services.",
    technologies: ["Java", "TypeScript", "Docker"],
  },
  {
    title: "mj-abrams.com",
    description:
      "My personal software engineering portfolio, built as a fast static website with Astro.",
    technologies: ["Astro", "TypeScript", "CSS"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>MJ Abrams — Software Engineer</title>

    <meta
      name="description"
      content="MJ Abrams — software engineering, systems, Linux and infrastructure."
    />
  </head>

  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/">MJ Abrams</a>

        <nav aria-label="Main navigation">
          <a href="#projects">Projects</a>
          <a href="#about">About</a>
          <a
            href="https://github.com/MJ-Abrams"
            target="_blank"
            rel="noreferrer"
          >
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero container">
        <div class="eyebrow">
          <span class="status-dot"></span>
          SOFTWARE ENGINEERING
        </div>

        <h1>
          Building software and systems
          <span>with structure.</span>
        </h1>

        <p class="hero-copy">
          Software Engineering Student interested in software architecture,
          Linux, systems and building reliable, maintainable software.
        </p>

        <div class="actions">
          <a class="primary" href="#projects">
            View projects
            <span aria-hidden="true">→</span>
          </a>

          <a
            class="secondary"
            href="https://github.com/MJ-Abrams"
            target="_blank"
            rel="noreferrer"
          >
            GitHub
          </a>
        </div>

        <div class="hero-meta">
          <span>01 / ENGINEERING</span>
          <span>ASTRO · TYPESCRIPT</span>
        </div>
      </section>

      <section id="projects" class="section container">
        <div class="section-heading">
          <span>02</span>

          <div>
            <p class="label">SELECTED WORK</p>
            <h2>Projects</h2>
          </div>
        </div>

        <div class="projects">
          {
            projects.map((project, index) => (
              <article class="project">
                <div class="project-index">
                  {String(index + 1).padStart(2, "0")}
                </div>

                <div class="project-content">
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>

                  <div class="technologies">
                    {project.technologies.map((technology) => (
                      <span>{technology}</span>
                    ))}
                  </div>
                </div>

                <span class="project-arrow" aria-hidden="true">
                  ↗
                </span>
              </article>
            ))
          }
        </div>
      </section>

      <section id="about" class="section container about">
        <div class="section-heading">
          <span>03</span>

          <div>
            <p class="label">ABOUT</p>
            <h2>Engineering with intent.</h2>
          </div>
        </div>

        <div class="about-grid">
          <p class="about-lead">
            I am interested in understanding how software and systems behave
            beyond the surface.
          </p>

          <div class="about-copy">
            <p>
              My focus is on maintainable architecture, backend development,
              systems, Linux and infrastructure.
            </p>

            <p>
              I prefer solutions that are understandable, reproducible and
              designed to remain maintainable as they grow.
            </p>
          </div>
        </div>
      </section>

      <section class="section container stack">
        <div class="section-heading">
          <span>04</span>

          <div>
            <p class="label">TECHNOLOGY</p>
            <h2>Current stack</h2>
          </div>
        </div>

        <div class="stack-grid">
          <div>
            <span class="stack-label">LANGUAGES</span>
            <p>Java · C · C++ · TypeScript</p>
          </div>

          <div>
            <span class="stack-label">SYSTEMS</span>
            <p>Linux · Docker · Git</p>
          </div>

          <div>
            <span class="stack-label">WEB</span>
            <p>Astro · HTML · CSS</p>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <span>MJ Abrams</span>
        <span>© {year}</span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0c0d0f;
    --surface: #121417;
    --text: #f1f3f5;
    --muted: #8c929a;
    --border: #25282d;
    --accent: #9fc5ff;

    --max-width: 1180px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(calc(100% - 48px), var(--max-width));
    margin-inline: auto;
  }

  .site-header {
    border-bottom: 1px solid var(--border);
  }

  .nav {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    gap: 32px;
  }

  nav a {
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 160ms ease;
  }

  nav a:hover {
    color: var(--text);
  }

  .hero {
    min-height: 720px;
    padding: 150px 0 48px;
    display: flex;
    flex-direction: column;
  }

  .eyebrow,
  .label,
  .hero-meta,
  .stack-label {
    font-family:
      "SFMono-Regular",
      Consolas,
      "Liberation Mono",
      monospace;
    letter-spacing: 0.1em;
    font-size: 0.72rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  h1 {
    max-width: 900px;
    margin: 35px 0 28px;
    font-size: clamp(3.4rem, 8vw, 7rem);
    line-height: 0.94;
    letter-spacing: -0.065em;
    font-weight: 600;
  }

  h1 span {
    color: var(--muted);
  }

  .hero-copy {
    max-width: 650px;
    margin: 0;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .actions {
    display: flex;
    gap: 12px;
    margin-top: 42px;
  }

  .actions a {
    padding: 12px 18px;
    border: 1px solid var(--border);
    font-size: 0.9rem;
    transition:
      transform 160ms ease,
      border-color 160ms ease;
  }

  .actions a:hover {
    transform: translateY(-2px);
    border-color: #555b63;
  }

  .primary {
    background: var(--text);
    color: var(--bg);
    display: flex;
    gap: 24px;
  }

  .secondary {
    color: var(--muted);
  }

  .hero-meta {
    margin-top: auto;
    padding-top: 100px;
    display: flex;
    justify-content: space-between;
    color: #5f646b;
  }

  .section {
    padding: 130px 0;
    border-top: 1px solid var(--border);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 80px 1fr;
    margin-bottom: 65px;
  }

  .section-heading > span {
    color: #555b63;
    font-family: monospace;
    font-size: 0.8rem;
  }

  .label {
    margin: 0 0 8px;
    color: var(--accent);
  }

  h2 {
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 550;
  }

  .projects {
    border-top: 1px solid var(--border);
  }

  .project {
    min-height: 190px;
    display: grid;
    grid-template-columns: 80px 1fr 40px;
    padding: 32px 0;
    border-bottom: 1px solid var(--border);
    transition: padding 180ms ease;
  }

  .project:hover {
    padding-left: 10px;
  }

  .project-index {
    font-family: monospace;
    color: #555b63;
    font-size: 0.8rem;
  }

  .project-content h3 {
    margin: 0 0 10px;
    font-size: 1.45rem;
    font-weight: 520;
  }

  .project-content p {
    max-width: 700px;
    margin: 0;
    color: var(--muted);
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 20px;
  }

  .technologies span {
    font-family: monospace;
    color: #686e76;
    font-size: 0.76rem;
  }

  .project-arrow {
    color: var(--muted);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    padding-left: 80px;
  }

  .about-lead {
    margin: 0;
    max-width: 500px;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    line-height: 1.25;
    letter-spacing: -0.03em;
  }

  .about-copy {
    max-width: 500px;
    color: var(--muted);
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-left: 80px;
    border-top: 1px solid var(--border);
  }

  .stack-grid > div {
    padding: 28px 25px 28px 0;
    border-bottom: 1px solid var(--border);
  }

  .stack-label {
    color: #626871;
  }

  .stack-grid p {
    margin: 12px 0 0;
  }

  footer {
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    min-height: 130px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.85rem;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  @media (max-width: 700px) {
    .container {
      width: min(calc(100% - 32px), var(--max-width));
    }

    nav {
      gap: 16px;
    }

    nav a:not(:last-child) {
      display: none;
    }

    .hero {
      min-height: 650px;
      padding-top: 110px;
    }

    h1 {
      font-size: clamp(3.2rem, 16vw, 5rem);
    }

    .section {
      padding: 90px 0;
    }

    .section-heading,
    .project {
      grid-template-columns: 40px 1fr;
    }

    .project-arrow {
      display: none;
    }

    .about-grid,
    .stack-grid {
      grid-template-columns: 1fr;
      margin-left: 40px;
      padding-left: 0;
      gap: 28px;
    }

    .hero-meta {
      gap: 20px;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      transition: none !important;
    }
  }
</style>